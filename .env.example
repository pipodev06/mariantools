# Proveedor de IA para texto e imágenes (api/ai.ts): cualquier API compatible con OpenAI y con visión.
# Ejemplos de AI_BASE_URL:
#   https://generativelanguage.googleapis.com/v1beta/openai   (Google Gemini)
#   https://api.groq.com/openai/v1                           (Groq)
#   https://openrouter.ai/api/v1                             (OpenRouter)
#   https://api.mistral.ai/v1                                (Mistral)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Transcripción de audio (api/transcribe.ts): API compatible con /audio/transcriptions.
# AI_AUDIO_API_KEY y AI_AUDIO_BASE_URL son opcionales: si faltan, usa AI_API_KEY y AI_BASE_URL.
AI_AUDIO_API_KEY=
AI_AUDIO_BASE_URL=
AI_AUDIO_MODEL=
