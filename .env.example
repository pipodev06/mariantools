# Proveedor de IA para texto e imágenes (api/ai.ts): cualquier API compatible con OpenAI y con visión.
# Ejemplos de AI_BASE_URL:
#   https://generativelanguage.googleapis.com/v1beta/openai   (Google Gemini)
#   https://api.groq.com/openai/v1                           (Groq)
#   https://openrouter.ai/api/v1                             (OpenRouter)
#   https://api.mistral.ai/v1                                (Mistral)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Cuentas y créditos (Supabase). SUPABASE_SERVICE_ROLE_KEY es SECRETA: solo servidor, nunca VITE_.
# Sin estas variables, en desarrollo la IA queda sin medición; en producción se cierra (503).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Usos de IA gratis por día y por visitante o usuario (por defecto 3) y sal para hashear IPs.
FREE_DAILY_USES=3
BILLING_SALT=
# Claves públicas para el navegador (la anon key es pública; la protegen las políticas RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Transcripción de audio (api/transcribe.ts): API compatible con /audio/transcriptions.
# AI_AUDIO_API_KEY y AI_AUDIO_BASE_URL son opcionales: si faltan, usa AI_API_KEY y AI_BASE_URL.
AI_AUDIO_API_KEY=
AI_AUDIO_BASE_URL=
AI_AUDIO_MODEL=
